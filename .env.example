# Скопируйте файл в .env.local и заполните нужные значения.
# Для локального запуска ничего заполнять не обязательно.

# Адрес сайта — для SEO, sitemap.xml и robots.txt.
# На Vercel и Render определяется автоматически.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Если пусто — заявки и отзывы сохраняются в файл .data/db.json
# (удобно локально, но на Vercel/Render такие данные пропадают при перезапуске).
# Таблицы создаются автоматически при первом обращении.
# Neon:     postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Пароль входа в админ-панель (/admin). Обязателен в продакшене.
# В режиме разработки (npm run dev) без него работает пароль «admin».
ADMIN_PASSWORD=

# Секрет подписи сессий админки. Необязательно: по умолчанию выводится из пароля.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# Уведомления о новых записях в Telegram (необязательно).
# Токен — у @BotFather, chat_id — у @userinfobot (или id группы, куда добавлен бот).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Папка для JSON-хранилища, если не используется PostgreSQL (необязательно).
# DATA_DIR=.data

# Размер пула соединений PostgreSQL (необязательно, по умолчанию 5).
# PG_POOL_MAX=5
